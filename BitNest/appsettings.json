{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "frontend": {
        "ClusterId": "frontendCluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "frontendCluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://frontend:80/"
          }
        }
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bitnestChunked;Username=bitnest;Password=bitnestpass"
  },
  "UploadsPath": ".//app//data//storage//",
  "AllowedHosts": "*"
}
